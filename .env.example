# Copy this file to .env and fill in your real values. Never commit .env.

# --- Groq API ---
# Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# --- Flask ---
# Any random long string. Used to sign session cookies.
SECRET_KEY=change_this_to_a_random_secret_string
FLASK_ENV=production
PORT=5000

# --- App limits ---
MAX_UPLOAD_MB=200

# --- Admin (optional) ---
# Set this to enable the /admin/activity log viewer (?token=...). Leave
# blank to disable it entirely.
ADMIN_TOKEN=

# --- Security (optional) ---
# Set to 1 once you've confirmed the app is served over HTTPS.
FORCE_SECURE_COOKIES=0
